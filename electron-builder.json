{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "org.sapira.mediaplayer",
  "productName": "Sapira Media Player",
  "copyright": "Copyright © 2026 Sapira Media Player Contributors",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "fileAssociations": [
    {
      "ext": [
        "mp4", "mkv", "webm", "mov", "m4v", "avi",
        "flv", "wmv", "mpg", "mpeg", "m2ts", "mts", "ts", "vob", "3gp", "ogv"
      ],
      "name": "Video File",
      "role": "Viewer"
    },
    {
      "ext": [
        "mp3", "flac", "wav", "ogg", "oga", "m4a", "aac", "opus",
        "wma", "aiff", "aif", "alac", "ape", "wv", "mka", "ac3", "dts"
      ],
      "name": "Audio File",
      "role": "Viewer"
    }
  ],
  "mac": {
    "category": "public.app-category.video",
    "icon": "build/icon.icns",
    "identity": null,
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ]
  },
  "dmg": {
    "artifactName": "Sapira-Media-Player-${version}-${arch}.${ext}",
    "title": "Sapira Media Player"
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "Sapira-Media-Player-Setup-${version}-${arch}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Sapira Media Player"
  },
  "portable": {
    "artifactName": "Sapira-Media-Player-Portable-${version}-${arch}.${ext}"
  },
  "appx": {
    "applicationId": "SapiraMediaPlayer",
    "identityName": "SapiraMediaPlayer",
    "displayName": "Sapira Media Player",
    "publisher": "CN=SapiraMediaPlayer",
    "publisherDisplayName": "Valentin Borsan",
    "backgroundColor": "#04050A",
    "languages": ["en-US", "ro-RO"],
    "showNameOnTiles": true,
    "capabilities": ["internetClient", "runFullTrust"]
  },
  "linux": {
    "icon": "build/icon.png",
    "category": "AudioVideo",
    "synopsis": "Minimalist open-source 4K video & lossless audio player",
    "maintainer": "Valentin Borșan <afterluma@gmail.com>",
    "artifactName": "Sapira-Media-Player-${version}-${arch}.${ext}",
    "desktop": {
      "entry": {
        "Name": "Sapira Media Player",
        "Comment": "Open-source audio & 4K cinema media player",
        "Categories": "AudioVideo;Audio;Video;Player;",
        "StartupWMClass": "sapira-media-player"
      }
    },
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ]
  }
}
