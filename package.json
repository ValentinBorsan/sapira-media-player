{
  "name": "sapira-media-player",
  "desktopName": "sapira-media-player.desktop",
  "version": "0.1.0",
  "description": "Sapira Media Player — Minimalist open-source audio & video desktop player.",
  "author": "Valentin Borșan <afterluma@gmail.com>",
  "homepage": "https://sapiraplayer.pages.dev/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ValentinBorsan/sapira-media-player.git"
  },
  "bugs": {
    "url": "https://github.com/ValentinBorsan/sapira-media-player/issues"
  },
  "keywords": [
    "media-player",
    "video-player",
    "audio-player",
    "electron",
    "ffmpeg",
    "ambilight",
    "flac",
    "hls",
    "radio"
  ],
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on http://localhost:5173 && electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:web": "tsc -b && vite build",
    "build": "npm run build:web && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "preview:landing": "python3 -m http.server 4173 -d landing",
    "upload:r2": "node scripts/upload-r2.mjs",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.json",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.json",
    "dist:msstore": "npm run build && electron-builder --win appx --x64 --config electron-builder.json",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.json",
    "dist:all": "npm run build && electron-builder --mac --win --linux --config electron-builder.json"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  }
}
